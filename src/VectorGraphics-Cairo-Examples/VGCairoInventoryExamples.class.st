"
I hold the one-click examples for VGCairoInventory, the frozen list of the Cairo selectors AeCanvas and Bloc really send. My examples answer the measurement itself, so inspecting one shows the progress table unit by unit without running anything by hand.
"
Class {
	#name : 'VGCairoInventoryExamples',
	#superclass : 'Object',
	#category : 'VectorGraphics-Cairo-Examples',
	#package : 'VectorGraphics-Cairo-Examples'
}

{ #category : 'examples' }
VGCairoInventoryExamples class >> inventory [
	<sampleInstance>
	"The specification itself. The Units tab counts, from the compiled methods, how many selectors
	 each unit still owes."

	^ VGCairoInventory
]
