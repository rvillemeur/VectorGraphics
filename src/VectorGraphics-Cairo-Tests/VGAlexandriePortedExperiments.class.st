{ #category : 'generated - do not edit' }
VGAlexandriePortedExperiments class >> fillLinearGradientExperiment [

	
	| surface context |
	surface := VGCairoImageSurface
		           extent: 100 @ 100
		           format: VGCairoSurfaceFormat argb32.
	context := surface newContext.
	"linear gradient fill without using VGCairoLinearGradientPattern, only color interpolation
	equivalent to VGCairoLinearGradientPattern from: 0 @ 0 to: 100 @ 100
		            addStopsFrom: { (0 -> Color white). (1 -> Color black) }. "

	context strokeSize: 0.5.
	0 to: 100 by: 0.5 do: [ :point |
		context
			sourceColor:
				(Color white interpolateTo: Color black at: point / 100);
			"moveTo: point @ 0 ; lineTo: point @ 100;" "horizontal"
			moveTo: 0 @ point; lineTo: 100 @ point; "vertical"
			stroke ].

	^ surface asForm
]

{ #category : 'generated - do not edit' }
VGAlexandriePortedExperiments class >> fillLinearGradientExperimentDiagonal [

	
	| surface context |
	surface := VGCairoImageSurface
		           extent: 100 @ 100
		           format: VGCairoSurfaceFormat argb32.
	context := surface newContext.
	"linear gradient fill without using VGCairoLinearGradientPattern, only color interpolation
	equivalent to VGCairoLinearGradientPattern from: 0 @ 0 to: 100 @ 100
		            addStopsFrom: { (0 -> Color white). (1 -> Color black) }. "
	context strokeSize: 0.5.

	0 to: 100 by: 0.1 do: [ :point |
		context sourceColor: (Color white interpolateTo: Color black at: point / 100).
		point < 50 ifTrue: [ context moveTo: point * 2 @ 0; lineTo: 0 @ (point * 2) ]
					  ifFalse: [ context moveTo: point * 2 - 100 @ 100; lineTo: 100 @ (point * 2 - 100) ].
		context stroke ].

	^ surface asForm
]

